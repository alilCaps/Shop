DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=shopee_db
# Set to true for hosted databases that require TLS (e.g. Aiven)
DB_SSL=false

# Long random string used to sign login tokens. Keep it secret.
AUTH_SECRET=change-me-to-a-long-random-string

# Port is set automatically by most hosts (Render, Railway); locally it defaults to 5000.
# PORT=5000

# Websites allowed to call this API (comma-separated). Leave empty in local development.
# CORS_ORIGIN=https://your-site.example.com

# Forgot-password emails. Without these, the code is printed in the server console
# (development only); in production no email would be sent.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, an "App password" as SMTP_PASS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# MAIL_FROM="Shopee Store <you@example.com>"
